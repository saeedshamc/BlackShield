    <!-- User guide -->
    <string name="section_help">Help</string>
    <string name="user_guide">How to use Sentinel</string>
    <string name="guide_unlock_title">App lock screen</string>
    <string name="guide_unlock_body">Settings → enable \"Sentinel lock when phone wakes\".\nWhen the screen turns on, enter your Sentinel password (not the Android system PIN).\nMain password = normal unlock.\nDuress password = unlock + hidden actions (file delete, etc.).\nTip: disable Android screen lock for a single-password experience.</string>
    <string name="guide_duress_title">Duress passwords</string>
    <string name="guide_duress_body">GO: Settings → Duress Passwords.\n1) Save main password first.\n2) Set duress password (different from main).\n3) Check actions (e.g. delete files).\n4) Tap Save duress.\nTEST: Close app → open → enter duress password. App opens; actions run in background.</string>
    <string name="guide_files_title">Selecting files for deletion</string>
    <string name="guide_files_body">GO: Settings → Duress Passwords → scroll to files section.\n• Pick files — system file manager\n• Pick files (alternate) — if first button does not open\n• Pick folder — for entire folders\nAssign each file to duress 1/2/3 with chips.</string>
    <string name="guide_apps_title">Locking apps</string>
    <string name="guide_apps_body">GO: Dashboard → Locked Apps (or App Locker card).\nTap + → search and select app from list.\nOUT: Remove app with trash icon.\nLock All Now locks every protected app immediately.</string>
    <string name="guide_profiles_title">Emergency profiles</string>
    <string name="guide_profiles_body">GO: Dashboard → Active Profile or Quick Access → Profiles.\nIN: Tap a profile to activate it.\nOUT: Tap Normal Mode profile to return to default.\nActive profile shows a checkmark.</string>
    <string name="guide_decoy_title">Decoy mode</string>
    <string name="guide_decoy_body">GO: Quick Access → Decoy.\nIN: Turn switch ON (or trigger via duress/panic).\nOUT: Return to Decoy screen → turn switch OFF.\nEdit fake gallery/contacts/notes from the same screen.</string>
    <string name="guide_rules_title">Automation rules</string>
    <string name="guide_rules_body">GO: Dashboard → Rules → + button.\nSet trigger (IF) and one or more actions (THEN).\nSave rule. Toggle switch to enable/disable.\nBack arrow returns to rules list.</string>
    <string name="guide_panic_title">Panic center</string>
    <string name="guide_panic_body">GO: Red emergency button on dashboard.\nTap actions for instant defense.\nBack arrow returns to dashboard.</string>
    <string name="guide_navigation_title">General navigation</string>
    <string name="guide_navigation_body">← Back arrow (top left) exits current screen.\nDashboard is home. Settings (gear icon) for language, duress, backup, and this guide.</string>
